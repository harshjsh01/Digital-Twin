# AAHAVAAN-RAIL Environment Configuration

# Backend API URL (Default local FastAPI service)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Operational Data Mode:
# 'auto' (Try live backend first, fall back gracefully to synthetic demo mode if offline)
# 'real' (Enforce live backend connection)
# 'demo' (Always use deterministic synthetic scenario data)
NEXT_PUBLIC_DATA_MODE=auto
